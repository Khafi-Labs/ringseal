# === REQUIRED SECRETS ===
# MASTER_SECRET must be at least 32 characters of high entropy.
# Generate with: openssl rand -hex 32
# WARNING: Changing this will invalidate all encrypted data.
MASTER_SECRET=

# ADMIN_SECRET must be at least 16 characters.
# Generate with: openssl rand -hex 16  
ADMIN_SECRET=

# Database password. Must match secrets/db_password.txt
DB_PASSWORD=

# === DATABASE ===
DATABASE_URL=postgresql://ringseal:${DB_PASSWORD}@postgres:5432/ringseal?sslmode=prefer

# === SERVER ===
HOST=0.0.0.0
PORT=8080
INTERNAL_PORT=9090

# === SECURITY ===
# Number of trusted reverse proxies in front of Ringseal.
# Set to 1 if behind nginx/haproxy, 2 if behind a CDN + nginx, etc.
TRUSTED_PROXY_COUNT=0

# Maximum lifetime of customer JWT tokens in seconds.
MAX_JWT_LIFETIME_SECONDS=300

# Require HTTPS for webhook URLs.
WEBHOOK_REQUIRE_HTTPS=true

# === RATE LIMITING ===
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
UNAUTH_RATE_LIMIT_REQUESTS=20
UNAUTH_RATE_LIMIT_WINDOW_SECONDS=60

# === SESSION ===
CODE_EXPIRY_SECONDS=60
MAX_ATTEMPTS=3
MAX_SESSIONS_PER_CUSTOMER=3
MAX_SESSIONS_WINDOW_SECONDS=300

# === LOGGING ===
RUST_LOG=ringseal=info,tower_http=info
